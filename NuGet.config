<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-local NuGet sources.

    <clear/> drops any machine/user-level sources so restore is reproducible
    and does not depend on a developer's personal feeds.

    The build also appends feeds via <RestoreSources> in
    shared-infrastructure/msbuild/props/SixLabors.Global.props
    (nuget.org, feedz.io, Azure dnceng). Those require network access.

    To build/test OFFLINE, the only packages NOT available on nuget.org are
    the test-only Azure dnceng packages (Microsoft.DotNet.RemoteExecutor and
    Microsoft.DotNet.XUnitExtensions). They are vendored under
    vendor/nuget-non-nugetorg so restore can resolve them without reaching
    the Azure feed. nuget.org packages are restored normally (or from the
    machine cache once populated).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vendored-non-nugetorg" value="vendor/nuget-non-nugetorg" />
  </packageSources>
</configuration>
